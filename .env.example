# Local Postgres connection (both can point to the same local database).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bruno"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/bruno"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-value"

# Optional locally — without it, photo uploads fall back to writing under
# public/uploads instead of Vercel Blob. Required in production.
# BLOB_READ_WRITE_TOKEN=""
